--- !u!114 &1930852993
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1930852990}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Objetivo:</b> criaturas sombrias saem da clareira e seguem a trilha
    at\xE9 o farol. Resista a todas as ondas, eliminando o m\xEDnimo de criaturas
    do n\xEDvel, antes que o tempo acabe.\n\n<b>Construir:</b> escolha uma torre
    no painel (ou teclas 1 e 2) e clique num pedestal livre. Eliminar criaturas rende
    <color=#FFE080>luz</color>, usada para construir mais torres.\n\n<b>Lanterna</b>
    (50): r\xE1pida, um alvo, mira no inimigo mais adiantado.\n<b>Prisma</b> (90):
    lenta, dano em \xE1rea e deixa os inimigos lentos, mira no mais resistente.\n\n<b>Luz
    e sombra:</b> fora do alcance das luzes, as criaturas andam mais r\xE1pido.\n\n<b>Derrota:</b>
    a vida do farol chega a zero, criaturas demais chegam ao farol ou o tempo acaba.\n\n<b>Controles:</b>
    clique/toque constr\xF3i \u2022 clique direito vende (50%) \u2022 P/Esc pausa."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
